# Credenciais do projeto Supabase (Dashboard → Settings → API)
# A chave anon/publishable é pública por design (protegida por RLS) — mas por
# convenção do projeto, nenhuma chave é commitada.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publishable

# OpenAI Whisper API (para transcrição de áudio em Fase 2a)
# Obter em: https://platform.openai.com/api-keys
VITE_WHISPER_API_KEY=sk-...
